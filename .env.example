# Copy to .env and fill in locally. Never commit .env. Never paste keys into chat.
# Polymarket US API key (https://polymarket.us/developer). Phase 1 uses it only
# to authenticate the market-data WebSocket; no trading endpoints are called.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Optional Telegram alerts (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
